+        content: `Pathway: ${result.name}
+Reactome ID: ${result.stId}
+Species: ${result.species?.[0]?.displayName || 'Unknown'}
+Description: ${result.summary || 'Unknown'}`,
+        url: `https://reactome.org/content/detail/${result.stId}`,
